<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="InventoryKamera.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="using:InventoryKamera.WinUI" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="InventoryKamera.WinUI" mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!--  Animation: Moves the laser line down the screen  -->
            <Storyboard x:Name="ScanAnimation" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation EnableDependentAnimation="True" Storyboard.TargetName="ScanLineTrans" Storyboard.TargetProperty="Y"
                                 From="0" To="600" Duration="0:0:1.5" />
            </Storyboard>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ZONE 1: CONFIGURATION PANEL (Left Column)  -->
        <Rectangle Fill="{ThemeResource LayerFillColorDefaultBrush}" Opacity="0.5" />
        <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">

            <StackPanel Spacing="8">
                <TextBlock Margin="4,0,0,0" Foreground="Gray"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="CONFIGURATION" />

                <!--  Characters  -->
                <Border Padding="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="SwitchCharacters" Header="Characters" IsOn="False" />
                        <NumberBox x:Name="NumCharCount" Grid.Column="1" Header="No. of Characters"
                                   Maximum="500" Minimum="1" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" Value="4" />
                    </Grid>
                </Border>

                <!--  Artifacts  -->
                <Border Padding="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleSwitch x:Name="SwitchArtifacts" Header="Artifacts" IsOn="True" />
                        <NumberBox x:Name="NumArtifactCount" Grid.Column="1" Header="Min Artifact Level"
                                   Maximum="20" Minimum="1" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" Value="1" />

                        <ToggleSwitch x:Name="EquipArtifacts" Grid.Row="1" Header="Equip Artifacts"
                                      IsOn="True" />
                        <NumberBox x:Name="NumberBoxArtRarity" Grid.Row="1" Grid.Column="1"
                                   Header="Min Artifact Rarity" Maximum="5" Minimum="1"
                                   Value="4" />
                    </Grid>
                </Border>

                <!--  Weapons  -->
                <Border Padding="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="SwitchWeapons" Header="Weapons" IsOn="True" />
                        <NumberBox x:Name="MInWeaponLevel" Grid.Column="1" Header="Min Weapon Level"
                                   Maximum="90" Minimum="1" SmallChange="1"
                                   SpinButtonPlacementMode="Compact" Value="1" />

                        <ToggleSwitch x:Name="EquipWeapons" Grid.Row="1" Header="Equip Weapons"
                                      IsOn="True" />
                        <NumberBox x:Name="NumberBoxWeaponRarity" Grid.Row="1" Grid.Column="1"
                                   Header="Min Weapon Rarity" Maximum="5" Minimum="1"
                                   Value="4" />
                    </Grid>
                </Border>

                <!--  Materials  -->
                <Border Padding="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ToggleSwitch x:Name="EnableMaterials" Header="Materials" IsOn="False" />
                        <ToggleSwitch x:Name="CharDevelopmentItems" Grid.Column="1" Header="Char Deve Items"
                                      IsOn="False" />
                    </Grid>
                </Border>

                <!--  Character Names  -->
                <Border Padding="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">

                    <StackPanel Spacing="8">
                        <TextBox Name="TravelerName" PlaceholderText="Traveler's Name" />
                        <TextBox Name="WandererName" PlaceholderText="Wanderer's Name" />
                        <TextBox Name="MannequinName1" PlaceholderText="Mannequin 1's Name" />
                        <TextBox Name="MannequinName2" PlaceholderText="Mannequin 2's Name" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--  ZONE 2: CENTRAL COMMAND (Center Column)  -->
        <Grid Grid.Column="1" Margin="16" Padding="12"
              ColumnSpacing="8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  VIEWPORT  -->
            <Border Height="220" Background="Black"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Viewbox Stretch="Uniform">
                        <Image x:Name="LivePreview" Opacity="0.8" Source="ms-appx:///Assets/StoreLogo.png" />
                    </Viewbox>

                    <!--  Scan Animation  -->
                    <Grid x:Name="ScanOverlay" VerticalAlignment="Top" Visibility="Collapsed">
                        <Border Height="2" HorizontalAlignment="Stretch" Background="#FFD700">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="ScanLineTrans" Y="0" />
                            </Border.RenderTransform>
                            <Border.Shadow>
                                <ThemeShadow />
                            </Border.Shadow>
                        </Border>
                    </Grid>

                    <!--  Status Overlay (Top Right)  -->
                    <StackPanel Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Padding="6,2" Background="#90000000" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="10" Foreground="#00FF00" Glyph="&#xE916;" />
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="White"
                                           Text="Scanned Items" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">

                <TextBlock Padding="8" Text="Scanner Output" />

            </Border>

            <!--  THE LOG CONSOLE  -->
            <Border Grid.Row="1" Grid.ColumnSpan="2"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Console Header  -->
                    <Border Grid.Row="0" Padding="12,6" Background="#15FFFFFF"
                            CornerRadius="8,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="12" Foreground="Gray" Glyph="&#xE756;" />
                            <TextBlock CharacterSpacing="50" FontSize="10" FontWeight="Bold"
                                       Foreground="Gray" Text="SYSTEM LOG" />
                        </StackPanel>
                    </Border>

                    <!--  The Log List  -->
                    <!-- Used ListView for performance. Bind this to an ObservableCollection<string> in code -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogPanel" Padding="12">
                            <!--  Placeholder Data to show design  -->
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="Gray"
                                       Text="[10:00:01] System Initialized." />
                            <TextBlock FontFamily="Consolas" FontSize="12" Foreground="Gray"
                                       Text="[10:00:02] Camera connected." />
                            <TextBlock FontFamily="Consolas" FontSize="12"
                                       Foreground="{ThemeResource SystemAccentColor}"
                                       Text="[10:00:05] Scanning..." />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  THE ACTION DECK  -->
            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="Gray"
                               Text="Waiting for Genshin Impact..." />

                    <!--  Progress Bar is now slimmer  -->
                    <ProgressBar x:Name="ScanProgress" Height="2" Margin="0,4,16,0"
                                 Foreground="{ThemeResource SystemAccentColor}"
                                 Maximum="100" Value="0" />
                </StackPanel>

                <!--  Start Button  -->
                <Button x:Name="BtnStart" Grid.Column="1" Width="140"
                        Height="48" CornerRadius="24"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE768;" />
                        <TextBlock FontSize="14" FontWeight="Bold" Text="START" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
